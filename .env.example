# Copy to .env and fill in. Never commit .env.
# The public site, one brokerage's workspace, and the operator admin.
PUBLIC_URL=http://localhost:5180
WORKSPACE_URL=http://demo.localhost:5180
ADMIN_URL=http://admin.localhost:5181

# Accounts used by the shared login sessions. Must be test accounts.
# Superadmin, agent and client belong to the brokerage at WORKSPACE_URL.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
AGENT_EMAIL=
AGENT_PASSWORD=
CLIENT_EMAIL=
CLIENT_PASSWORD=
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
